; Lanceur de Claude of Duty Zombie : projet Godot séparé (voir docs/LAUNCHER.md).
; Exporté par tools/release.sh en build/ClaudeOfDutyZombie-Launcher.exe.

config_version=5

[application]

config/name="Claude of Duty Zombie - Lanceur"
config/description="Lanceur : mises à jour automatiques, choix de la version, notes de version."
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
; Dossier de réglages de l'ancien nom (réglages du lanceur conservés).
config/custom_user_dir_name="CallOfClaudeZombieLauncher"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
; Journal vidé à chaque ligne (dernières lignes gardées en cas de plantage).
run/flush_stdout_on_print=true

[debug]

; Journaux comme le jeu (docs/ARCHITECTURE.md « Journaux et plantages ») :
; user://logs toujours écrit, 14 jours au moins (CrashLog.prune) ; binaire de
; l'éditeur (tests) : jamais le dossier du joueur.
file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/log_path="user://logs/godot.log"
file_logging/log_path.editor="res://tests/_out/logs/launcher.log"
file_logging/max_log_files=1000
file_logging/max_log_files.editor=5

[display]

; Taille des maquettes sur un écran 1920 × 1080 ; mise à l'échelle de l'écran au
; démarrage (main.gd _fit_screen), jamais selon la taille de la
; fenêtre (agrandie : plus de place, pas de textes plus gros).
window/size/viewport_width=1190
window/size/viewport_height=690

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
