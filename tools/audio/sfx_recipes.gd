class_name SfxRecipes
extends RefCounted
## Recettes des sons importés : enregistrements libres de droits (CC0 1.0,
## freesound.org, voir docs/ASSETS.md) découpés et retravaillés par
## tools/audio/sfx_import.gd. Tout son listé dans RECIPES n'est plus généré
## par tools/gen_audio.gd (liste d'exclusion).
##
## Recette : {preset, layers: [couche...], eq, comp, drive, room, len, peak_db, loop, max_len}
## Couche : {src (id SOURCES), start, end (s dans la source), pitch (>1 = plus
##   aigu et plus court), gain (dB relatifs), at (décalage s), hp, lp,
##   eq: [[lp|hp|peak|lowshelf|highshelf, f, q, dB]...], len, fade_out}
## eq globale : [[type, fréquence, q, gain dB]...] ; comp : [seuil dB, ratio,
## attaque s, relâche s] ; room : [taille, mouillé, queue s, amortissement].

## Chaînes de traitement communes (fusionnées sous la recette).
const PRESETS := {
	# Tir entendu à la première personne dans une pièce fermée (Kino, bunker) :
	# grave renforcé, présence, aigus adoucis, compression, légère saturation,
	# queue de réverbération d'intérieur courte.
	"gun": {"eq": [["hp", 45.0, 0.7, 0.0], ["lowshelf", 130.0, 0.7, 3.5], ["peak", 2800.0, 1.0, 1.5], ["highshelf", 9000.0, 0.7, -3.0]],
		"comp": [-16.0, 3.0, 0.001, 0.06], "drive": 1.6, "room": [0.5, 0.2, 0.55, 0.45], "peak_db": -0.8, "max_len": 2.5},
	"gun_heavy": {"eq": [["hp", 35.0, 0.7, 0.0], ["lowshelf", 110.0, 0.7, 4.5], ["peak", 2500.0, 1.0, 1.0], ["highshelf", 9000.0, 0.7, -3.0]],
		"comp": [-16.0, 3.0, 0.001, 0.08], "drive": 1.8, "room": [0.65, 0.24, 0.9, 0.45], "peak_db": -0.8, "max_len": 3.0},
	"explosion": {"eq": [["hp", 30.0, 0.7, 0.0], ["lowshelf", 90.0, 0.7, 4.0]], "comp": [-18.0, 4.0, 0.002, 0.2],
