	# Mécanique d'arme (rechargement) : propre, présente, un peu de pièce.
	"mech": {"eq": [["hp", 90.0, 0.7, 0.0], ["peak", 3500.0, 1.0, 1.5]], "comp": [-14.0, 2.5, 0.002, 0.05],
		"room": [0.3, 0.1, 0.25, 0.5], "peak_db": -1.5, "max_len": 1.6},
	# Voix de zombie : voix humaines rauques, grave et raclement renforcés,
	# légère saturation, peu de réverbération (la spatialisation 3D fait le reste).
	"zombie": {"eq": [["hp", 80.0, 0.7, 0.0], ["lowshelf", 180.0, 0.7, 2.5], ["peak", 2400.0, 1.2, 2.0], ["highshelf", 8000.0, 0.7, -2.0]],
