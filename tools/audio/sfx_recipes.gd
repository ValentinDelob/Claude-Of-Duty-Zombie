		"peak_db": -1.5, "max_len": 2.5},
	# Impacts de balles sur le décor : attaque sèche, présence, queue courte.
	"impact": {"eq": [["hp", 90.0, 0.7, 0.0], ["peak", 3200.0, 1.0, 2.0]], "comp": [-12.0, 3.0, 0.001, 0.05],
