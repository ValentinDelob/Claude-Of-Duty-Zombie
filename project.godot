; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Claude of Duty Zombie"
; Dossier de données de l'ancien nom : réglages et dossier de combat conservés.
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Call of Claude Zombie"
config/description="FPS coop zombies low-poly horreur"
config/version="0.2.1"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
; Journal vidé à chaque ligne, même dans l'exe exporté : les dernières lignes
; avant un plantage restent dans le journal (CrashLog).
run/flush_stdout_on_print=true

[autoload]

Packs="*res://scripts/autoload/packs.gd"
CrashGuard="*res://scripts/autoload/crash_guard.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
GameState="*res://scripts/autoload/game_state.gd"
Settings="*res://scripts/autoload/settings.gd"
Net="*res://scripts/autoload/net.gd"
Router="*res://scripts/autoload/router.gd"
Audio="*res://scripts/autoload/audio.gd"
Autotest="*res://scripts/autoload/autotest.gd"

[debug]

; Journaux (docs/ARCHITECTURE.md « Journaux et plantages ») : un fichier par
; lancement dans user://logs, toujours écrit (exe exporté compris), gardé au
; moins 14 jours (nettoyage par date au démarrage : CrashLog.prune, total
; borné à 200 Mo ; le nombre de fichiers n'est qu'une limite de secours).
; Binaire de l'éditeur (tests, agents, scénarios lancés à la main) : jamais le
; dossier du joueur, mais tests/_out/logs (et --log-file partout dans tools/).
file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/log_path="user://logs/godot.log"
file_logging/log_path.editor="res://tests/_out/logs/godot.log"
file_logging/max_log_files=1000
file_logging/max_log_files.editor=5

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="zombies"
3d_physics/layer_4="hitboxes"
3d_physics/layer_5="barriers"
3d_physics/layer_7="ragdolls"
3d_physics/layer_8="low_obstacles"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=0

[shader_globals]

vm_fov_scale={
"type": "float",
"value": 1.0
}
vm_bend={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
